# All optional. Every one has a working fallback; nothing here is required to run the system.

# Research agent hits the hosted API instead of self-hosted Playwright.
FIRECRAWL_API_KEY=

# Which backend to prefer: auto | firecrawl | playwright | null
RESEARCH_BACKEND=auto

# What WE sell. A prospect job post mentioning these is the highest-weight buying signal,
# and it is necessarily deployment-specific.
OUR_CATEGORY=

# Where the op log and research cache live.
RAINMAKER_DATA=data

# Console origin(s) allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5174
